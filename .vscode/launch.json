{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Next: Node (9229 / main)",
            "port": 9229,
            "address": "localhost",
            "localRoot": "${workspaceFolder}/frontend",
            "remoteRoot": "/var/app",
            "protocol": "inspector",
            "restart": true,
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Next: Node (9230 / worker)",
            "port": 9230,
            "address": "localhost",
            "localRoot": "${workspaceFolder}/frontend",
            "remoteRoot": "/var/app",
            "protocol": "inspector",
            "restart": true,
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Next: Chrome (Client)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMapPathOverrides": { "webpack:///./*": "${webRoot}/*" },
            "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
        }
    ],
    "compounds": [
        {
            "name": "Next: Full Stack (Docker)",
            "configurations": ["Next: Node (9229 / main)", "Next: Node (9230 / worker)", "Next: Chrome (Client)"],
            "stopAll": true
        }
    ]
}